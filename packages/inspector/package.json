{
  "name": "@ui-tuner/inspector",
  "version": "0.1.0",
  "description": "DOM inspection primitives for UI Tuner: element picker, overlay, selection identity (chrome-free)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ui-tuner/protocol": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
