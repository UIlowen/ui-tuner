{
  "name": "@ui-tuner/chrome-extension",
  "version": "0.1.0",
  "description": "UI Tuner Chrome Extension (Manifest V3): Side Panel + Content Script",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run build:sidepanel && pnpm run build:content && pnpm run build:background",
    "build:sidepanel": "vite build -c vite.config.sidepanel.ts",
    "build:content": "vite build -c vite.config.content.ts",
    "build:background": "vite build -c vite.config.background.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ui-tuner/inspector": "workspace:*",
    "@ui-tuner/protocol": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
